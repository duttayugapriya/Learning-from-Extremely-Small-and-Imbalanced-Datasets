# .gitignore for extremely-small-imbalanced-learning

# Python
__pycache__/
*.pyc
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/

# Virtual environments
.env
.venv
.venv/
env/
venv/
ENV/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Data files (store separately / in DVC)
*.parquet
*.pkl
*.pickle
*.h5
*.hdf5
data/raw/
data/processed/

# Ignore general data CSVs but track curated experiment result tables
*.csv
!results/**/*.csv
!results/*.csv

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# Results (large outputs — store in a separate results branch or DVC)
results/figures/*.png
results/figures/*.pdf
